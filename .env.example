# ──────────────────────────────────────────────────────────────
# TOEFL AI Prep — environment variables
# Copy to `.env` and adjust. Used by docker-compose and both apps.
# ──────────────────────────────────────────────────────────────

# ---- Database (PostgreSQL) ----
POSTGRES_USER=toefl
POSTGRES_PASSWORD=toefl_password_change_me
POSTGRES_DB=toefl
# When running the API inside docker-compose, host is the service name `db`.
# For local (non-docker) dev, use localhost.
DATABASE_URL=postgresql://toefl:toefl_password_change_me@db:5432/toefl?schema=public

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# ---- JWT ----
# Generate strong secrets, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=900           # seconds (15 min)
JWT_REFRESH_TTL=1209600      # seconds (14 days)

# ---- AI provider ----
# Provider: "openai" or "mock". If no OPENAI_API_KEY is set, the app
# automatically falls back to the deterministic mock provider / question bank.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Storage (Speaking recordings / Writing essays) ----
# "local" stores files under STORAGE_DIR; "s3" reserved for later phases.
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api
