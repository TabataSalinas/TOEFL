// TOEFL AI Prep — Prisma schema
// Covers all phases so the data model is stable. Phase 1 actively uses
// Reading/Listening + scoring + reporting; Speaking/Writing/RAG fields are
// present but populated in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────── Enums ────────────────────────────────

enum Section {
  READING
  LISTENING
  SPEAKING
  WRITING
}

enum ExamKind {
  FULL // all four sections
  SECTION // single-section practice
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum SectionAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum QuestionType {
  // Reading
  READING_MULTIPLE_CHOICE
  READING_INSERT_TEXT
  READING_VOCABULARY
  READING_INFERENCE
  READING_FACTUAL
  READING_NEGATIVE_FACTUAL
  READING_RHETORICAL_PURPOSE
  READING_SENTENCE_SIMPLIFICATION
  READING_PROSE_SUMMARY
  // 2026 format — Reading
  READING_COMPLETE_WORDS
  READING_MAIN_PURPOSE
  READING_DETAIL
  READING_PARAGRAPH_RELATIONSHIP
  // Listening
  LISTENING_MAIN_IDEA
  LISTENING_DETAIL
  LISTENING_FUNCTION
  LISTENING_ATTITUDE
  LISTENING_ORGANIZATION
  LISTENING_INFERENCE
  LISTENING_CONNECTING_CONTENT
  // 2026 format — Listening
  LISTENING_CHOOSE_RESPONSE
  LISTENING_PREDICTION
  // Productive
  SPEAKING_INDEPENDENT
  SPEAKING_INTEGRATED
  WRITING_INTEGRATED
  WRITING_ACADEMIC_DISCUSSION
  // 2026 format — Writing / Speaking
  WRITING_BUILD_SENTENCE
  WRITING_EMAIL
  SPEAKING_LISTEN_REPEAT
  SPEAKING_INTERVIEW
}

enum PlanItemStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

// ──────────────────────────────── Users ────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  // OAuth (phase 3). Null for password accounts.
  oauthProvider String?
  oauthId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          UserProfile?
  refreshTokens    RefreshToken[]
  passwordResets   PasswordReset[]
  attempts         ExamAttempt[]
  studyPlans       StudyPlan[]
  goals            Goal[]
  studySessions    StudySession[]

  @@index([oauthProvider, oauthId])
}

model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetTotalScore   Int      @default(100) // 0..120 scale
  testDate           DateTime?
  preferredStudyMinutesPerDay Int   @default(45)
  theme              String   @default("system") // light | dark | system
  nativeLanguage     String?
  // Rolling streak counters
  currentStreakDays  Int      @default(0)
  longestStreakDays  Int      @default(0)
  lastStudyDate      DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ──────────────────────── Exams / question content ────────────────────────

// An Exam is a generated template (blueprint of sections + questions).
// Reusable across attempts; generated by AI or seeded fallback bank.
model Exam {
  id          String   @id @default(cuid())
  kind        ExamKind
  title       String
  description String?
  // For single-section exams, which section it covers.
  section     Section?
  difficulty  String   @default("standard") // easy | standard | hard
  generatedBy String   @default("mock") // openai | mock | seed
  // Unique-ish signature to avoid repeating identical generated exams.
  contentHash String?
  createdAt   DateTime @default(now())

  sections ExamSection[]
  attempts ExamAttempt[]

  @@index([section])
  @@index([contentHash])
}

model ExamSection {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  section      Section
  order        Int
  timeLimitSec Int
  // Instructions shown before the section starts.
  instructions String?
  // Adaptive modules (Reading/Listening): 1 or 2. Writing/Speaking are linear (module 1).
  module       Int      @default(1)
  // core (module 1) | easy | hard (module 2 routing)
  variant      String   @default("core")

  passages  Passage[]
  questions Question[]

  @@index([examId])
}

// A reading passage or a listening stimulus (lecture/conversation transcript).
model Passage {
  id            String   @id @default(cuid())
  examSectionId String
  examSection   ExamSection @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  order         Int
  title         String?
  // Reading: article text. Listening: full transcript used for grading + review.
  body          String
  // Listening audio: path to generated/synthesized file or TTS script.
  audioUrl      String?
  topic         String?  // e.g. biology, art history, campus life
  wordCount     Int      @default(0)
  // Stimulus kind: complete_words | email | notice | flyer | academic | choose_response |
  // conversation | announcement | talk | build_sentence | email_task | discussion |
  // listen_repeat | interview
  kind          String?
  // Kind-specific structured data (email headers, dialogue turns, discussion posts, ...)
  meta          Json?
  // Id of the curated bank item (if any) — used to avoid repeats
  bankId        String?
  // Open-license sources used to ground the content (attribution)
  sourceRefs    Json?
  contentFingerprint String?

  questions Question[]

  @@index([examSectionId])
}

model Question {
  id            String   @id @default(cuid())
  examSectionId String
  examSection   ExamSection @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  passageId     String?
  passage       Passage?  @relation(fields: [passageId], references: [id], onDelete: SetNull)
  order         Int
  type          QuestionType
  section       Section
  prompt        String
  // For MCQ: JSON array of { id, text }. For productive tasks: null.
  options       Json?
  // For objective questions: the correct option id(s). JSON string[] or string.
  correctAnswer Json?
  // AI-authored rationale shown after the exam.
  explanation   String?
  // Skill tag for weakness analysis (e.g. "inference", "vocabulary").
  skillTag      String?
  points        Int      @default(1)
  // 2026 task kind (COMPLETE_WORDS, BUILD_SENTENCE, ...)
  taskKind      String?
  // Kind-specific data (chunks/layout for Build a Sentence, highlighted word, ...)
  meta          Json?
  // Per-question clock in seconds (Listening / Speaking / Writing steps)
  timeLimitSec  Int?

  answers Answer[]

  @@index([examSectionId])
  @@index([type])
}

// ──────────────────────────── Attempts / answers ────────────────────────────

model ExamAttempt {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  examId      String
  exam        Exam          @relation(fields: [examId], references: [id])
  kind        ExamKind
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  sectionAttempts SectionAttempt[]
  scoreReport     ScoreReport?

  @@index([userId])
  @@index([examId])
}

model SectionAttempt {
  id            String               @id @default(cuid())
  examAttemptId String
  examAttempt   ExamAttempt          @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  section       Section
  // Exam section (module) this attempt runs
  examSectionId String?
  module        Int                  @default(1)
  status        SectionAttemptStatus @default(NOT_STARTED)
  startedAt     DateTime?
  // Hard deadline computed from the section time limit.
  deadlineAt    DateTime?
  completedAt   DateTime?
  timeSpentSec  Int                  @default(0)

  answers     Answer[]
  recordings  Recording[]
  essays      Essay[]
  sectionScore SectionScore?

  @@index([examAttemptId])
}

model Answer {
  id               String   @id @default(cuid())
  sectionAttemptId String
  sectionAttempt   SectionAttempt @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id])
  // Selected option id(s): JSON string | string[].
  response         Json?
  isCorrect        Boolean?
  // Locked answers cannot be changed (Listening: no going back)
  locked           Boolean  @default(false)
  pointsEarned     Int      @default(0)
  timeSpentSec     Int      @default(0)
  answeredAt       DateTime @default(now())

  @@unique([sectionAttemptId, questionId])
  @@index([questionId])
}

// ──────────────── Productive artifacts (Speaking / Writing) ────────────────
// Present now; graded in later phases.

model Recording {
  id               String   @id @default(cuid())
  sectionAttemptId String
  sectionAttempt   SectionAttempt @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  questionId       String
  fileUrl          String
  durationSec      Int      @default(0)
  transcript       String?
  // client | whisper | none
  transcriptSource String?
  mimeType         String?
  // Speaking metrics JSON: wordsPerMinute, longPauses, fillers, etc.
  metrics          Json?
  // Rubric evaluation (dimensions, errors, citations, ...)
  analysis         Json?
  score            Float?   // 0..5
  createdAt        DateTime @default(now())

  @@index([sectionAttemptId])
}

model Essay {
  id               String   @id @default(cuid())
  sectionAttemptId String
  sectionAttempt   SectionAttempt @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  questionId       String
  content          String
  wordCount        Int      @default(0)
  taskType         String?  // WRITE_EMAIL | ACADEMIC_DISCUSSION
  score            Float?   // 0..5
  // Writing feedback JSON: errors, improvedVersion, rubric breakdown.
  feedback         Json?
  createdAt        DateTime @default(now())

  @@index([sectionAttemptId])
}

// ──────────────────────────── Scores & reports ────────────────────────────

model ScoreReport {
  id            String      @id @default(cuid())
  examAttemptId String      @unique
  examAttempt   ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  totalScore    Int         // 0..120
  totalBand     Float?      // 1..6 (2026 scale)
  confidence    Float       @default(0) // 0..1
  // Human-readable explanation of how the estimate was computed.
  methodology   String?
  // Aggregated per-section summary (modules, adaptive path, scaled score, band, confidence)
  sectionSummary Json?
  createdAt     DateTime    @default(now())

  sectionScores SectionScore[]
}

model SectionScore {
  id               String   @id @default(cuid())
  scoreReportId    String
  scoreReport      ScoreReport @relation(fields: [scoreReportId], references: [id], onDelete: Cascade)
  sectionAttemptId String   @unique
  sectionAttempt   SectionAttempt @relation(fields: [sectionAttemptId], references: [id], onDelete: Cascade)
  section          Section
  rawCorrect       Int      @default(0)
  rawTotal         Int      @default(0)
  scaledScore      Int      @default(0) // 0..30
  band             Float?   // 1..6
  confidence       Float    @default(0)
  // Per-skill accuracy JSON for weakness analysis.
  skillBreakdown   Json?
  createdAt        DateTime @default(now())

  @@index([scoreReportId])
}

// ──────────────────────── Study plans, goals, sessions ────────────────────────

model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  targetScore Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items StudyPlanItem[]

  @@index([userId])
}

model StudyPlanItem {
  id          String         @id @default(cuid())
  studyPlanId String
  studyPlan   StudyPlan      @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  order       Int
  section     Section?
  skillTag    String?
  title       String
  description String?
  estMinutes  Int            @default(30)
  // Estimated score points gained by completing this item.
  estPointsGain Float        @default(0)
  status      PlanItemStatus @default(PENDING)

  @@index([studyPlanId])
}

model Goal {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  period     GoalPeriod
  // Target minutes of study for the period.
  targetMinutes Int     @default(300)
  // Period anchor (start of week/month).
  periodStart DateTime
  createdAt  DateTime   @default(now())

  @@unique([userId, period, periodStart])
  @@index([userId])
}

model StudySession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section?
  minutes    Int      @default(0)
  source     String   @default("exam") // exam | drill | review
  occurredAt DateTime @default(now())

  @@index([userId])
  @@index([occurredAt])
}

// ──────────────────────────── RAG knowledge base ────────────────────────────
// Populated in phase 2. Stores rubric chunks / reference examples + embeddings.

model KnowledgeChunk {
  id         String   @id @default(cuid())
  section    Section?
  kind       String   // rubric | anchor | guideline
  taskType   String?  // WRITE_EMAIL | ACADEMIC_DISCUSSION | INTERVIEW | LISTEN_REPEAT | ...
  tags       String[] @default([])
  contentHash String? @unique
  title      String?
  content    String
  // Embedding stored as JSON array of floats (pgvector swap-in later).
  embedding  Json?
  source     String?
  createdAt  DateTime @default(now())

  @@index([section, kind])
}

// ───────────────────── Open-license source documents ─────────────────────
// Facts fetched from openly licensed sources (Wikipedia, OpenStax, NASA, ...) used
// ONLY to ground original content. License + URL kept for attribution.
model SourceDocument {
  id        String   @id @default(cuid())
  provider  String   // wikipedia | openstax | nasa | gutenberg | manual
  title     String
  url       String   @unique
  license   String   // e.g. CC BY-SA 4.0, CC BY 4.0, Public Domain
  topic     String?
  text      String
  fetchedAt DateTime @default(now())

  @@index([topic])
}
